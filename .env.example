# Live mode. Leave MONGODB_URI empty to run the browser-only demo.
# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=arts_fashion
# random, at least 32 characters (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
# one-time key asked for on the first-run setup screen
BMS_SETUP_KEY=
# Optional: store photos on Cloudinary (from Cloudinary Dashboard → "API environment variable").
# Without it, photos are stored in MongoDB.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=arts-fashion
